{
  "name": "hackutd2026",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "shared",
    "spacetimedb",
    "app",
    "test-client"
  ],
  "scripts": {
    "dev": "npm run dev -w app",
    "build": "npm run build -w app",
    "typecheck": "tsc --noEmit -p shared && tsc --noEmit -p spacetimedb && vue-tsc --noEmit -p test-client && npm run typecheck -w app",
    "test-client": "npm run dev -w test-client",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm run format:check",
    "build:module": "npm run build -w spacetimedb",
    "publish:local": "spacetime publish -s local",
    "bindings": "npm run bindings -w app && npm run bindings -w test-client"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "typescript": "~5.6.2",
    "typescript-eslint": "^8.72.1"
  }
}
