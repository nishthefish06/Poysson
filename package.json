{
  "name": "hackutd2026",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "shared",
    "spacetimedb"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit -p shared && tsc --noEmit -p spacetimedb",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm run format:check",
    "build:module": "npm run build -w spacetimedb",
    "publish:local": "spacetime publish -s local"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "typescript": "~5.6.2",
    "typescript-eslint": "^8.72.1"
  }
}
