# Copy to .env (git-ignored) and fill in. Every env var the project reads is listed here.

# --- Front end (Nuxt runtime config) ---
# ws://localhost:3000 locally; wss://<ip-with-dashes>.sslip.io or your domain on Vultr
NUXT_PUBLIC_SPACETIME_URL=ws://localhost:3000
NUXT_PUBLIC_SPACETIME_DB=hackutd2026

# --- Deploy scripts (deploy/vultr/*.sh) ---
# SSH target of the Vultr server
VULTR_SSH=root@203.0.113.10
SPACETIME_DB=hackutd2026

# --- Not used yet: reserved names for upcoming integrations ---
GEMINI_API_KEY=
NVIDIA_API_KEY=
PHOTON_PROJECT_ID=
PHOTON_PROJECT_SECRET=
