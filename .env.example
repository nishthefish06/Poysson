# Copy to .env (git-ignored) and fill in. Every env var the project reads is listed here.

# --- Front end (Nuxt runtime config) ---
# ws://127.0.0.1:3000 locally (not localhost: the server is IPv4-only); wss://<PUBLIC_HOST> on Vultr
NUXT_PUBLIC_SPACETIME_URL=ws://127.0.0.1:3000
NUXT_PUBLIC_SPACETIME_DB=hackutd2026
# Dev server only: browse pages without logging in (UI work without a running SpacetimeDB)
NUXT_PUBLIC_DEV_BYPASS_AUTH=

# --- AI + messaging (Nuxt server only, never sent to the browser) ---
# Lets the Nemotron agent register as a trusted service in SpacetimeDB. deploy.sh also passes it
# to the module at publish time. 16+ random characters, e.g. `openssl rand -hex 24`.
SERVICE_SECRET=
GEMINI_API_KEY=
# Unset = gemini-flash-latest. Lite is faster and has more free-tier quota.
GEMINI_MODEL=gemini-flash-lite-latest
GEMINI_EMBED_MODEL=gemini-embedding-001
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# Check which models your key can call (some return 404 per account). Lightning is fast and works on the free tier.
NEMOTRON_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
# 1 = let the model think first (slower, can run out of tokens); default 0
NEMOTRON_THINKING=0
PHOTON_PROJECT_ID=
PHOTON_PROJECT_SECRET=
# Photon may only text consenting teammates: ref=+1number pairs, comma-separated
DEMO_PHONE_MAP=

# --- Deploy scripts (deploy/vultr/*.sh) ---
VULTR_SSH=root@203.0.113.10
# Hostname Caddy serves: <ip-with-dashes>.sslip.io, or the domain once DNS points at the server
PUBLIC_HOST=poysson.fishing
SPACETIME_DB=hackutd2026
# Password for the demo accounts (seed_demo_accounts / seed_demo_activity)
DEMO_PASSWORD=

# Solana devnet (audit anchoring + soulbound badges). Server-only; never commit a real key.
# SOLANA_SECRET_KEY is the wallet's 64-number JSON array (solana-keygen new -o wallet.json; then cat it).
# Fund it with devnet SOL at faucet.solana.com.
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_SECRET_KEY=
SOLANA_METADATA_BASE_URL=
