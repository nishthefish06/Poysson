# Copy to .env (git-ignored) and fill in. Every env var the project reads is listed here.

# --- Front end (Nuxt runtime config; the test client reads these too) ---
# ws://127.0.0.1:3000 locally (not localhost: the server is IPv4-only); wss://<PUBLIC_HOST> on Vultr
NUXT_PUBLIC_SPACETIME_URL=ws://127.0.0.1:3000
NUXT_PUBLIC_SPACETIME_DB=hackutd2026
# Dev server only: browse pages without logging in (UI work without a running SpacetimeDB)
NUXT_PUBLIC_DEV_BYPASS_AUTH=

# --- AI + messaging (Nuxt server only, never sent to the browser) ---
# Lets the Nemotron agent register as a trusted service in SpacetimeDB. deploy.sh also passes it
# to the module at publish time. 16+ random characters, e.g. `openssl rand -hex 24`.
SERVICE_SECRET=
GEMINI_API_KEY=
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NEMOTRON_MODEL=
PHOTON_PROJECT_ID=
PHOTON_PROJECT_SECRET=
# Photon may only text consenting teammates: ref=+1number pairs, comma-separated
DEMO_PHONE_MAP=

# --- Deploy scripts (deploy/vultr/*.sh) ---
VULTR_SSH=root@203.0.113.10
# Hostname Caddy serves: <ip-with-dashes>.sslip.io, or the domain once DNS points at the server
PUBLIC_HOST=poysson.fishing
SPACETIME_DB=hackutd2026
